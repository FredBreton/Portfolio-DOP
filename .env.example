# Copier vers .env. Ne jamais envoyer .env sur GitHub.
DATABASE_URL=postgresql://fred:local@127.0.0.1:54329/fred
# Longue valeur aléatoire, différente pour chaque environnement.
PAYLOAD_SECRET=
SITE_URL=http://localhost:3010
# Mettre true seulement au lancement : sinon Google est bloqué.
SITE_INDEXABLE=false

# Stockage des fichiers (vide = dossier media/ local)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Adresse publique du stockage, sans barre oblique à la fin
S3_PUBLIC_URL=

# Courriels du formulaire (vide = le message reste seulement dans Payload)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Protection Turnstile (vide = champ piège et limite d'envois seulement)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Compte de test local créé par npm run seed (facultatif)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
