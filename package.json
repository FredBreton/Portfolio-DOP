{
  "name": "portfolio-dop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db": "docker compose up -d",
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "payload": "payload",
    "generate": "payload generate:importmap && payload generate:types",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "node --import tsx scripts/seed.ts",
    "ci": "payload migrate && next build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/email-nodemailer": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/storage-s3": "3.94.2",
    "@payloadcms/translations": "3.94.2",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "3.94.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "happy-dom": "21.0.4"
  }
}
